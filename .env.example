# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/genshape3d

# Cloudflare R2
R2_ENDPOINT=https://edad30fa0fe66f50971087c6b0df0f28.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=genshape3d
R2_PUBLIC_URL=https://edad30fa0fe66f50971087c6b0df0f28.r2.cloudflarestorage.com/genshape3d

# Hunyuan3D local endpoint
HUNYUAN3D_URL=http://localhost:8080

# Poll interval in ms
POLL_INTERVAL=10000

# Worker identity. Stamped on jobs this machine claims so each app's UI
# can filter to "only my jobs". Must be unique per machine.
#   1080 → WORKER_ID=i7-1080
#   3090 → WORKER_ID=win-3090
WORKER_ID=i7-1080

# Comma-separated list of models this machine can run. Pending-jobs
# query filters by this so a machine never grabs a job it can't run.
#   1080 has only generate.py (Hunyuan3D)            → WORKER_MODELS=hunyuan3d
#   3090 has all four runner venvs under runners/   → WORKER_MODELS=hunyuan3d,triposr,sf3d,hi3dgen
WORKER_MODELS=hunyuan3d
